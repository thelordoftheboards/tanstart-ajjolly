{
  "name": "tanstart-ajjolly",
  "version": "0.1.29",
  "private": false,
  "license": "unlicense",
  "author": {
    "name": "Alexander C",
    "url": "https://github.com/thelordoftheboards"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:bump": "bun pm version patch --no-git-tag-version",
    "build:icons": "icon-gen -i src/base-config/icon/logo-32x32-background-dark-mode.svg -o ./public/favicon --favicon",
    "check": "biome check && bun check-types",
    "check:fix": "biome check --write",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .tanstack && rm -rf dist && rm -rf node_modules/.vite",
    "compose:down": "docker compose --file docker-compose.yaml down --volumes",
    "compose:up": "bun docker:build && docker compose --file docker-compose.yaml up --detach --force-recreate",
    "dev": "vite dev --strictPort --port 8080",
    "docker:build": "bun make && ./devtools/docker-build.sh",
    "format": "biome format --write",
    "lint": "biome lint",
    "make": "bun run clean && bun run format && bun build:bump && bun run build",
    "prepare": "husky",
    "preview": "vite preview",
    "ui": "bunx shadcn@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@t3-oss/env-core": "0.13.11",
    "@tabler/icons-react": "3.48.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.48.0",
    "motion": "^13.4.4",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "4.13.3",
    "recharts": "3.10.1",
    "redaxios": "0.5.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "uuid": "14.0.2",
    "vaul": "1.1.2",
    "vite": "8.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "icon-gen": "5.0.0",
    "oxc-transform-react": "0.151.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "bun@1.4.2"
}
