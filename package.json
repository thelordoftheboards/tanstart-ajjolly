{
  "name": "tanstart-ajjolly",
  "version": "0.1.7",
  "private": false,
  "type": "module",
  "author": {
    "name": "Alexander C",
    "url": "https://github.com/thelordoftheboards"
  },
  "packageManager": "bun@1.3.9",
  "license": "unlicense",
  "scripts": {
    "dev": "vite dev --strictPort --port 8080",
    "build": "vite build",
    "build:bump": "bun pm version patch --no-git-tag-version",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint",
    "check:fix": "biome check --write",
    "check-types": "tsc --noEmit",
    "check": "biome check && bun check-types",
    "ui": "bunx shadcn@latest",
    "make": "bun run clean && bun run format && bun build:bump && bun run build",
    "docker:build": "bun make && ./devtools/docker-build.sh",
    "compose:up": "bun docker:build && docker compose --file docker-compose.yaml up --detach --force-recreate",
    "compose:down": "docker compose --file docker-compose.yaml down --volumes",
    "clean": "rm -rf .tanstack && rm -rf dist && rm -rf node_modules/.vite",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "@t3-oss/env-core": "0.13.10",
    "@tabler/icons-react": "3.36.1",
    "@tanstack/react-form": "1.28.0",
    "@tanstack/react-query": "5.90.20",
    "@tanstack/react-router": "1.159.5",
    "@tanstack/react-router-ssr-query": "1.159.5",
    "@tanstack/react-start": "1.159.5",
    "@vitejs/plugin-react": "5.1.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.563.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "react-resizable-panels": "4.6.4",
    "recharts": "2.15.4",
    "redaxios": "0.5.1",
    "shadcn": "3.8.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "uuid": "13.0.0",
    "vaul": "1.1.2",
    "vite": "8.0.0-beta.14",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/devtools-vite": "0.5.1",
    "@types/bun": "1.3.9",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "ultracite": "7.1.5"
  }
}
